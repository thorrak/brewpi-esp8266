# CONFIG_WS2812_LED_ENABLE is not set

# CONFIG_BT_BLUEDROID_ENABLED is not set

CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=n
CONFIG_ESP_HTTPS_SERVER_ENABLE=n

# Needed for now to hit iram targets, but should be re-evaluated in the future
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_XTAL_FREQ_AUTO=y

# Main task runs setup() which initializes WiFi manager, mDNS, LittleFS, BLE, display, etc.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# FreeRTOS Timer task needs more stack for WiFi manager and logging callbacks
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# The host stack needs to be larger to support certain WiFi Manager operations
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_LOG_LEVEL=2

# ESP WiFi Config component settings
# Reducing max networks (we don't use alternate networks), enabling (Custom) Web UI, and enabling BLE setup
CONFIG_WIFI_CFG_MAX_NETWORKS=2
# CONFIG_WIFI_CFG_ENABLE_CLI is not set
CONFIG_WIFI_CFG_ENABLE_WEBUI=y
CONFIG_WIFI_CFG_WEBUI_CUSTOM_PATH="/littlefs/wifiui"
CONFIG_WIFI_CFG_ENABLE_CUSTOM_BLE=y
